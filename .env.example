# Copy this file to .env and fill in your real keys.
# Create keys at: https://www.binance.com/en/my/settings/api-management
#
# SECURITY:
#   - Enable ONLY the permissions you need (e.g. "Enable Reading", "Enable Spot Trading").
#   - Restrict access to a whitelisted IP address.
#   - Do NOT enable withdrawals unless you absolutely need them.
#   - .env is git-ignored. Never share or commit these values.

BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Set to "true" to use the Spot Testnet (fake funds) instead of live.
# Start with "true" while developing the bot. Get testnet keys at
# https://testnet.binance.vision
BINANCE_TESTNET=true

# --- Claude (the bot's decision engine) ---
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_key_here
